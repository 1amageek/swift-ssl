diff --git a/llvm/lib/Target/AArch64/AArch64MIPeepholeOpt.cpp b/llvm/lib/Target/AArch64/AArch64MIPeepholeOpt.cpp
index 0ddd17cee..e8fd8e913 100644
--- a/llvm/lib/Target/AArch64/AArch64MIPeepholeOpt.cpp
+++ b/llvm/lib/Target/AArch64/AArch64MIPeepholeOpt.cpp
@@ -67,6 +67,17 @@
 // 9. Replace UBFMXri with UBFMWri if the instruction is equivalent to a 32 bit
 //    LSR or LSL alias of UBFM.
 //
+// 10. Preserve SHA256H's first input before the destructive update when an
+//     immediately following SHA256H2 consumes the old value. This lets
+//     two-address lowering keep both hash state updates in place:
+//
+//   %new0 = SHA256Hrrr %state0, %state1, %work
+//   %new1 = SHA256H2rrr %state1, %state0, %work
+//     ==>
+//   %saved0 = ORRv16i8 %state0, %state0
+//   %new0 = SHA256Hrrr %state0, %state1, %work
+//   %new1 = SHA256H2rrr %state1, %saved0, %work
+//
 //===----------------------------------------------------------------------===//
 
 #include "AArch64ExpandImm.h"
@@ -135,6 +146,7 @@ struct AArch64MIPeepholeOpt : public MachineFunctionPass {
   bool visitFMOVDr(MachineInstr &MI);
   bool visitUBFMXri(MachineInstr &MI);
   bool visitCopy(MachineInstr &MI);
+  bool visitSHA256H(MachineInstr &MI);
   bool runOnMachineFunction(MachineFunction &MF) override;
 
   StringRef getPassName() const override {
@@ -836,6 +848,53 @@ bool AArch64MIPeepholeOpt::visitCopy(MachineInstr &MI) {
   return true;
 }
 
+bool AArch64MIPeepholeOpt::visitSHA256H(MachineInstr &MI) {
+  MachineBasicBlock &MBB = *MI.getParent();
+  MachineBasicBlock::iterator Position = MI.getIterator();
+  auto Next = next_nodbg(Position, MBB.end());
+  if (Next == MBB.end() || Next->getOpcode() != AArch64::SHA256H2rrr)
+    return false;
+
+  MachineInstr &SHA256H2 = *Next;
+  Register State0 = MI.getOperand(1).getReg();
+  Register State1 = MI.getOperand(2).getReg();
+  Register Work = MI.getOperand(3).getReg();
+  if (!State0.isVirtual() || State0 == State1 || State0 == Work ||
+      SHA256H2.getOperand(1).getReg() != State1 ||
+      SHA256H2.getOperand(2).getReg() != State0 ||
+      SHA256H2.getOperand(3).getReg() != Work)
+    return false;
+
+  SmallPtrSet<MachineInstr *, 32> FollowingInstructions;
+  for (auto It = std::next(Position); It != MBB.end(); ++It)
+    FollowingInstructions.insert(&*It);
+
+  SmallVector<MachineOperand *, 4> UsesToPreserve;
+  for (MachineOperand &Use : MRI->use_operands(State0)) {
+    MachineInstr *User = Use.getParent();
+    if (User == &MI && Use.getOperandNo() == 1)
+      continue;
+    if (User->getParent() == &MBB) {
+      if (FollowingInstructions.contains(User))
+        UsesToPreserve.push_back(&Use);
+      continue;
+    }
+    return false;
+  }
+
+  Register SavedState0 =
+      MRI->createVirtualRegister(MRI->getRegClass(State0));
+  // Use the target move form instead of COPY. A generic COPY is coalesced
+  // into SHA256H's destructive destination, recreating the original register
+  // schedule instead of ending State0's live range at SHA256H.
+  BuildMI(MBB, MI, MI.getDebugLoc(), TII->get(AArch64::ORRv16i8), SavedState0)
+      .addReg(State0)
+      .addReg(State0);
+  for (MachineOperand *Use : UsesToPreserve)
+    Use->setReg(SavedState0);
+  return true;
+}
+
 bool AArch64MIPeepholeOpt::runOnMachineFunction(MachineFunction &MF) {
   if (skipFunction(MF.getFunction()))
     return false;
@@ -927,6 +986,9 @@ bool AArch64MIPeepholeOpt::runOnMachineFunction(MachineFunction &MF) {
       case AArch64::COPY:
         Changed |= visitCopy(MI);
         break;
+      case AArch64::SHA256Hrrr:
+        Changed |= visitSHA256H(MI);
+        break;
       }
     }
   }
diff --git a/llvm/test/CodeGen/AArch64/sha256-paired-two-address.ll b/llvm/test/CodeGen/AArch64/sha256-paired-two-address.ll
new file mode 100644
index 000000000..1d5ef7ba3
--- /dev/null
+++ b/llvm/test/CodeGen/AArch64/sha256-paired-two-address.ll
@@ -0,0 +1,35 @@
+; RUN: llc -verify-machineinstrs -mtriple=aarch64-linux-gnu -mattr=+sha2 < %s | FileCheck %s
+
+declare <4 x i32> @llvm.aarch64.crypto.sha256h(
+  <4 x i32>, <4 x i32>, <4 x i32>
+)
+declare <4 x i32> @llvm.aarch64.crypto.sha256h2(
+  <4 x i32>, <4 x i32>, <4 x i32>
+)
+
+define void @sha256_paired_update(
+  ptr %new0Pointer,
+  ptr %new1Pointer,
+  ptr %saved0Pointer,
+  <4 x i32> %state0,
+  <4 x i32> %state1,
+  <4 x i32> %work
+) {
+; CHECK-LABEL: sha256_paired_update:
+; CHECK:       mov v3.16b, v0.16b
+; CHECK-NEXT:  sha256h q0, q1, v2.4s
+; CHECK-NEXT:  sha256h2 q1, q3, v2.4s
+; CHECK-NEXT:  str q0, [x0]
+; CHECK-NEXT:  str q1, [x1]
+; CHECK-NEXT:  str q3, [x2]
+  %new0 = call <4 x i32> @llvm.aarch64.crypto.sha256h(
+    <4 x i32> %state0, <4 x i32> %state1, <4 x i32> %work
+  )
+  %new1 = call <4 x i32> @llvm.aarch64.crypto.sha256h2(
+    <4 x i32> %state1, <4 x i32> %state0, <4 x i32> %work
+  )
+  store <4 x i32> %new0, ptr %new0Pointer
+  store <4 x i32> %new1, ptr %new1Pointer
+  store <4 x i32> %state0, ptr %saved0Pointer
+  ret void
+}
diff --git a/llvm/test/CodeGen/AArch64/peephole-sha256-paired-two-address.mir b/llvm/test/CodeGen/AArch64/peephole-sha256-paired-two-address.mir
new file mode 100644
index 000000000..bb618c9d3
--- /dev/null
+++ b/llvm/test/CodeGen/AArch64/peephole-sha256-paired-two-address.mir
@@ -0,0 +1,69 @@
+# RUN: llc -run-pass=aarch64-mi-peephole-opt -verify-machineinstrs -mtriple=aarch64-unknown-linux -o - %s | FileCheck %s
+
+---
+name: paired_sha256_state
+body: |
+  bb.0:
+    liveins: $q0, $q1, $q2
+
+    ; CHECK-LABEL: name: paired_sha256_state
+    ; CHECK: [[STATE0:%[0-9]+]]:fpr128 = COPY $q0
+    ; CHECK: [[STATE1:%[0-9]+]]:fpr128 = COPY $q1
+    ; CHECK: [[WORK:%[0-9]+]]:fpr128 = COPY $q2
+    ; CHECK: [[SAVED:%[0-9]+]]:fpr128 = ORRv16i8 [[STATE0]], [[STATE0]]
+    ; CHECK-NEXT: [[NEW0:%[0-9]+]]:fpr128 = SHA256Hrrr [[STATE0]], [[STATE1]], [[WORK]]
+    ; CHECK-NEXT: [[NEW1:%[0-9]+]]:fpr128 = SHA256H2rrr [[STATE1]], [[SAVED]], [[WORK]]
+    ; CHECK-NEXT: [[FEED_FORWARD:%[0-9]+]]:fpr128 = ORRv16i8 [[SAVED]], [[SAVED]]
+    ; CHECK-NEXT: RET_ReallyLR
+    %0:fpr128 = COPY $q0
+    %1:fpr128 = COPY $q1
+    %2:fpr128 = COPY $q2
+    %3:fpr128 = SHA256Hrrr %0, %1, %2
+    %4:fpr128 = SHA256H2rrr %1, %0, %2
+    %5:fpr128 = ORRv16i8 %0, %0
+    RET_ReallyLR
+...
+---
+name: mismatched_sha256_work
+body: |
+  bb.0:
+    liveins: $q0, $q1, $q2, $q3
+
+    ; CHECK-LABEL: name: mismatched_sha256_work
+    ; CHECK: [[STATE0:%[0-9]+]]:fpr128 = COPY $q0
+    ; CHECK: [[STATE1:%[0-9]+]]:fpr128 = COPY $q1
+    ; CHECK: [[WORK0:%[0-9]+]]:fpr128 = COPY $q2
+    ; CHECK: [[WORK1:%[0-9]+]]:fpr128 = COPY $q3
+    ; CHECK-NEXT: [[NEW0:%[0-9]+]]:fpr128 = SHA256Hrrr [[STATE0]], [[STATE1]], [[WORK0]]
+    ; CHECK-NEXT: [[NEW1:%[0-9]+]]:fpr128 = SHA256H2rrr [[STATE1]], [[STATE0]], [[WORK1]]
+    ; CHECK-NEXT: RET_ReallyLR
+    %0:fpr128 = COPY $q0
+    %1:fpr128 = COPY $q1
+    %2:fpr128 = COPY $q2
+    %3:fpr128 = COPY $q3
+    %4:fpr128 = SHA256Hrrr %0, %1, %2
+    %5:fpr128 = SHA256H2rrr %1, %0, %3
+    RET_ReallyLR
+...
+---
+name: separated_sha256_pair
+body: |
+  bb.0:
+    liveins: $q0, $q1, $q2
+
+    ; CHECK-LABEL: name: separated_sha256_pair
+    ; CHECK: [[STATE0:%[0-9]+]]:fpr128 = COPY $q0
+    ; CHECK: [[STATE1:%[0-9]+]]:fpr128 = COPY $q1
+    ; CHECK: [[WORK:%[0-9]+]]:fpr128 = COPY $q2
+    ; CHECK: [[NEW0:%[0-9]+]]:fpr128 = SHA256Hrrr [[STATE0]], [[STATE1]], [[WORK]]
+    ; CHECK-NEXT: [[SEPARATOR:%[0-9]+]]:fpr128 = ORRv16i8 [[WORK]], [[WORK]]
+    ; CHECK-NEXT: [[NEW1:%[0-9]+]]:fpr128 = SHA256H2rrr [[STATE1]], [[STATE0]], [[WORK]]
+    ; CHECK-NEXT: RET_ReallyLR
+    %0:fpr128 = COPY $q0
+    %1:fpr128 = COPY $q1
+    %2:fpr128 = COPY $q2
+    %3:fpr128 = SHA256Hrrr %0, %1, %2
+    %4:fpr128 = ORRv16i8 %2, %2
+    %5:fpr128 = SHA256H2rrr %1, %0, %2
+    RET_ReallyLR
+...
